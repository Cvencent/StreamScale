@echo off
REM StreamScale launcher for Sunshine prep-cmd.
REM Generated by install/setup.py -- safe to move with the project folder.
REM
REM Why a wrapper instead of calling python directly: Sunshine prep commands
REM run in a minimal environment, so PYTHONPATH would otherwise have to be
REM set system-wide. Setting it here keeps the project self-contained and
REM makes the prep-cmd string short and readable.
setlocal
set "PYTHONPATH=__SRC__"
"__PYTHON__" -m streamscale.cli %*
exit /b %ERRORLEVEL%
